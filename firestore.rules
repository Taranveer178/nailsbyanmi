rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /siteSettings/{documentId} {
      allow get: if documentId == 'admin';
      allow list: if false;
      allow create, update: if documentId == 'admin'
        && isAdmin()
        && request.resource.data.version == 2
        && request.resource.data.sections is list
        && request.resource.data.deletedItemIds is list;
      allow delete: if false;
    }
  }
}